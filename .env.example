# Copy to .env and fill in. Never commit .env.

# RPC endpoints used by `forge script --rpc-url <name>`
BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=

# Who controls the protocol (a multisig). Defaults to the deployer.
OWNER=
# Optional: seconds every owner action must wait in a public timelock, e.g. 172800 for two days.
TIMELOCK_DELAY=

# Chainlink VRF v2.5, required on public networks
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUB_ID=
