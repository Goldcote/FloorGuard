# Copy to .env and fill in. Never commit .env.

# RPC endpoints used by `forge script --rpc-url <name>`
BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=

# Final owner of every contract (a multisig). Defaults to the deployer.
OWNER=

# Chainlink VRF v2.5, required on public networks
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUB_ID=
