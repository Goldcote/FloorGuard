{
  "name": "floorguard-keeper",
  "private": true,
  "version": "0.1.0",
  "description": "Permissionless maintenance bot for the FloorGuard protocol",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "once": "node --disable-warning=ExperimentalWarning src/index.ts once",
    "watch": "node --disable-warning=ExperimentalWarning src/index.ts watch",
    "monitor": "node --disable-warning=ExperimentalWarning src/index.ts monitor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
