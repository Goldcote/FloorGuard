pragma solidity ^0.8.26;

import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
import {ITreasury} from "./interfaces/IFloorGuard.sol";

/// @title Treasury
/// @notice Accumulates protocol fees as per-collection buyback budgets. Fees generated by a collection
///         are earmarked for defending that collection's floor. ETH sent without a collection is
///         unallocated until the owner assigns it.
/// @dev The owner cannot withdraw directly, but it chooses the spender, so it is fully trusted. It should
///      be a timelocked multisig.
contract Treasury is ITreasury, Ownable2Step {
    /// @notice The only address allowed to spend budgets (the BuybackEngine).
    address public spender;
    mapping(address collection => uint256) public budgetOf;
    uint256 public unallocated;

    event Deposited(address indexed collection, address indexed from, uint256 amount);
    event UnallocatedReceived(address indexed from, uint256 amount);
    event Allocated(address indexed collection, uint256 amount);
    event Spent(address indexed collection, address indexed to, uint256 amount);
    event SpenderSet(address indexed spender);

    error NotSpender();
    error InsufficientBudget(uint256 available, uint256 requested);
    error TransferFailed();

    constructor(address owner_) Ownable(owner_) {}

    receive() external payable {
        unallocated += msg.value;
        emit UnallocatedReceived(msg.sender, msg.value);
    }

    /// @inheritdoc ITreasury
    function deposit(address collection) external payable {
        budgetOf[collection] += msg.value;
        emit Deposited(collection, msg.sender, msg.value);
    }

    /// @notice Assign unallocated ETH to a collection's buyback budget.
    function allocate(address collection, uint256 amount) external onlyOwner {
        if (amount > unallocated) revert InsufficientBudget(unallocated, amount);
        unallocated -= amount;
        budgetOf[collection] += amount;
        emit Allocated(collection, amount);
    }

    /// @inheritdoc ITreasury
    function spend(address collection, uint256 amount, address payable to) external {
        if (msg.sender != spender) revert NotSpender();
        uint256 budget = budgetOf[collection];
        if (amount > budget) revert InsufficientBudget(budget, amount);
        budgetOf[collection] = budget - amount;
        emit Spent(collection, to, amount);
        (bool ok,) = to.call{value: amount}("");
        if (!ok) revert TransferFailed();
    }

    function setSpender(address spender_) external onlyOwner {
        spender = spender_;
        emit SpenderSet(spender_);
    }
}
