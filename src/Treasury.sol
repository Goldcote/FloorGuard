pragma solidity ^0.8.26;

import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
import {ITreasury, IBudgetListener} from "./interfaces/IFloorGuard.sol";

/// @title Treasury
/// @notice Accumulates protocol fees as per-collection buyback budgets. Fees generated by a collection
///         are earmarked for defending that collection's floor. ETH sent without a collection is
///         unallocated until the owner assigns it.
/// @dev The owner cannot withdraw directly, but it chooses the spender, so it is fully trusted. It should
///      be a timelocked multisig.
contract Treasury is ITreasury, Ownable2Step {
    /// @notice The only address allowed to spend budgets (the BuybackEngine).
    address public spender;
    mapping(address collection => uint256) public budgetOf;
    uint256 public unallocated;

    struct ProjectShare {
        address recipient;
        uint16 bps;
    }

    uint256 public constant BPS = 10_000;
    uint256 public constant MAX_PROJECT_SHARE_BPS = 5_000;
    uint256 private constant NOTICE_GAS = 60_000;
    /// @notice The share of a collection's fees that goes to the NFT project itself, like a royalty.
    mapping(address collection => ProjectShare) public projectShareOf;
    /// @notice Project shares waiting to be claimed.
    mapping(address recipient => uint256) public owedTo;
    uint256 public totalOwed;

    event Deposited(address indexed collection, address indexed from, uint256 amount);
    event UnallocatedReceived(address indexed from, uint256 amount);
    event Allocated(address indexed collection, uint256 amount);
    event Spent(address indexed collection, address indexed to, uint256 amount);
    event SpenderSet(address indexed spender);
    event ProjectShareSet(address indexed collection, address indexed recipient, uint256 bps);
    event ProjectShareAccrued(address indexed collection, address indexed recipient, uint256 amount);
    event ProjectShareClaimed(address indexed recipient, uint256 amount);

    error NotSpender();
    error InsufficientBudget(uint256 available, uint256 requested);
    error TransferFailed();
    error InvalidShare();
    error NothingOwed();

    constructor(address owner_) Ownable(owner_) {}

    receive() external payable {
        unallocated += msg.value;
        emit UnallocatedReceived(msg.sender, msg.value);
    }

    /// @inheritdoc ITreasury
    function deposit(address collection) external payable {
        _credit(collection, msg.value);
        emit Deposited(collection, msg.sender, msg.value);
    }

    /// @inheritdoc ITreasury
    function depositFee(address collection) external payable returns (uint256 toBudget) {
        ProjectShare memory share = projectShareOf[collection];
        uint256 toProject = msg.value * share.bps / BPS;
        if (toProject != 0) {
            owedTo[share.recipient] += toProject;
            totalOwed += toProject;
            emit ProjectShareAccrued(collection, share.recipient, toProject);
        }
        toBudget = msg.value - toProject;
        _credit(collection, toBudget);
        emit Deposited(collection, msg.sender, toBudget);
    }

    /// @notice Withdraw the project shares accrued to the caller.
    function claimProjectShare() external {
        claimProjectShareTo(payable(msg.sender));
    }

    /// @notice Withdraw the caller's accrued project shares to another address, for recipients that
    ///         cannot receive ETH themselves.
    function claimProjectShareTo(address payable to) public {
        uint256 amount = owedTo[msg.sender];
        if (amount == 0) revert NothingOwed();
        owedTo[msg.sender] = 0;
        totalOwed -= amount;
        emit ProjectShareClaimed(msg.sender, amount);
        (bool ok,) = to.call{value: amount}("");
        if (!ok) revert TransferFailed();
    }

    /// @notice Set the share of a collection's future fees paid to its project. Zero bps turns it off.
    function setProjectShare(address collection, address recipient, uint16 bps) external onlyOwner {
        if (bps > MAX_PROJECT_SHARE_BPS || (bps != 0 && recipient == address(0))) revert InvalidShare();
        projectShareOf[collection] = ProjectShare(recipient, bps);
        emit ProjectShareSet(collection, recipient, bps);
    }

    /// @notice Assign unallocated ETH to a collection's buyback budget.
    function allocate(address collection, uint256 amount) external onlyOwner {
        if (amount > unallocated) revert InsufficientBudget(unallocated, amount);
        unallocated -= amount;
        _credit(collection, amount);
        emit Allocated(collection, amount);
    }

    /// @inheritdoc ITreasury
    function spend(address collection, uint256 amount, address payable to) external {
        if (msg.sender != spender) revert NotSpender();
        uint256 budget = budgetOf[collection];
        if (amount > budget) revert InsufficientBudget(budget, amount);
        budgetOf[collection] = budget - amount;
        emit Spent(collection, to, amount);
        (bool ok,) = to.call{value: amount}("");
        if (!ok) revert TransferFailed();
    }

    function setSpender(address spender_) external onlyOwner {
        spender = spender_;
        emit SpenderSet(spender_);
    }

    /// @dev Adds to a budget and tells the spender, which uses it to restart a bid curve that ran ahead
    ///      of an empty budget. The notice is best effort and can never block a deposit.
    function _credit(address collection, uint256 amount) private {
        uint256 before = budgetOf[collection];
        budgetOf[collection] = before + amount;
        address listener = spender;
        if (amount != 0 && listener.code.length != 0) {
            // capped so that a listener can never use up the gas of a randomness callback
            try IBudgetListener(listener).onBudgetIncrease{gas: NOTICE_GAS}(collection, before) {} catch {}
        }
    }
}
