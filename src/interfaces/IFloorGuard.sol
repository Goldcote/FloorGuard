pragma solidity ^0.8.26;

/// @notice Source of a collection's floor price, in wei.
interface IFloorOracle {
    /// @dev MUST revert when no usable price exists. Consumers check `updatedAt` for staleness themselves.
    function floorPrice(address collection) external view returns (uint256 price, uint256 updatedAt);
}

/// @notice Sink for floor-type sales observed inside the protocol (see SalesFloorOracle).
interface ISaleRecorder {
    function recordSale(address collection, uint256 price) external;
}

interface ITreasury {
    /// @notice Deposit ETH earmarked for buybacks of `collection`. For recycled capital, not fees.
    function deposit(address collection) external payable;
    /// @notice Deposit a protocol fee earned on `collection`. The collection's project share, if one is
    ///         set, is put aside for the project; the rest becomes buyback budget.
    /// @return toBudget The part of the fee that became buyback budget.
    function depositFee(address collection) external payable returns (uint256 toBudget);
    function spend(address collection, uint256 amount, address payable to) external;
    function budgetOf(address collection) external view returns (uint256);
    function projectShareOf(address collection) external view returns (address recipient, uint16 bps);
}

/// @notice Told by the Treasury when a collection's budget grows.
interface IBudgetListener {
    function onBudgetIncrease(address collection, uint256 budgetBefore) external;
}

interface IVault {
    function registerDeposit(address collection, uint256 tokenId, uint256 price)
        external
        returns (uint256 vaultId);
}

interface IPoints {
    /// @notice Credit `user` with points for `feeWei` of protocol fees generated by the calling module.
    function creditFee(address user, uint256 feeWei) external;
    function totalPoints() external view returns (uint256);
    function freezeCount() external view returns (uint256);
    function pick(uint256 randomWord) external view returns (address);
    function resetWinner(address user) external;
    /// @notice Block activation of pending points until `unfreeze`, so weights cannot move mid-draw.
    function freeze() external;
    function unfreeze() external;
}

interface IVaultRaffle {
    function open(address collection, uint256 tokenId) external returns (uint256 raffleId);
}

interface IRandomnessProvider {
    function requestRandomness() external returns (uint256 requestId);
}

interface IRandomnessConsumer {
    function fulfillRandomness(uint256 requestId, uint256 randomWord) external;
}
